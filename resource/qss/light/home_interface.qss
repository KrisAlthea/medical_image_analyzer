/* 首页（HomeInterface） light */
HomeInterface, #view {
    background-color: transparent;
}
ScrollArea {
    border: none;
    background-color: transparent;
}

/* 渐变横幅 */
CardWidget#gradientBanner {
    background: transparent;
    border: none;
}

/* 横幅标题 */
TitleLabel#bannerTitle {
    font: 24px 'Microsoft YaHei Light';
    font-weight: 600;
    color: #303133;
}
BodyLabel#bannerDescription {
    font: 16px 'Microsoft YaHei Light';
    color: #606266;
}

/* “开始体验”按钮 */
PrimaryPushButton {
    background-color: #409EFF;
    color: #ffffff;
    border-radius: 4px;
    padding: 0 12px;
    min-height: 32px;
}
PrimaryPushButton:hover {
    background-color: #66B1FF;
}

/* 功能模块标题 */
SubtitleLabel#sectionTitle {
    font: 20px 'Microsoft YaHei Light';
    font-weight: 600;
    color: #303133;
}

/* 功能卡片 */
CardWidget#functionCard {
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 8px;
}
CardWidget#functionCard StrongBodyLabel {
    font: 16px 'Microsoft YaHei Light';
    font-weight: 600;
    color: #303133;
}
CardWidget#functionCard BodyLabel {
    font: 14px 'Microsoft YaHei Light';
    color: #606266;
}
/* 卡片右侧箭头 */
TransparentToolButton {
    color: #909399;
}
TransparentToolButton:hover {
    color: #409EFF;
}

/* 页脚 */
CardWidget#footer {
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 8px;
}
SubtitleLabel#tipsLabel {
    font: 14px 'Microsoft YaHei Light';
    color: #606266;
}
QFrame#footerSeparator {
    background-color: #ebeef5;
    height: 1px;
    border: none;
}
CaptionLabel#versionInfo {
    font: 12px 'Microsoft YaHei Light';
    color: #909399;
}

/* 弹窗提示（InfoBar） */
InfoBar {
    border-radius: 4px;
    padding: 8px 12px;
}
