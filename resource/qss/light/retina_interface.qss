/* 工具栏样式 */
QWidget#toolbar {
    background-color: #f0f0f0;
    padding: 10px;
}

/* 按钮样式 */
ToolButton {
    background-color: #0078d7;
    color: white;
    border: none;
    padding: 5px 15px;
    border-radius: 5px;
}

ToolButton:hover {
    background-color: #005ea2;
}

/* 图片标签样式 */
QLabel {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    padding: 10px;
}

/* 数据展示区样式 */
QTextEdit {
    background-color: #ffffff;
    border: 1px solid #cccccc;
    padding: 10px;
    font-family: "Consolas", monospace;
    font-size: 14px;
}