/* 历史记录页 light */
HistoryInterface, #historyView {
    background-color: transparent;
}
ScrollArea {
    border: none;
    background-color: transparent;
}

/* 顶部标题区 */
SubtitleLabel#pageTitle {
    font: 24px 'Microsoft YaHei Light';
    font-weight: 600;
    color: #303133;
}
BodyLabel#pageDescription {
    font: 14px 'Microsoft YaHei Light';
    color: #606266;
}

/* 表格卡片 */
CardWidget#tableCard {
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 8px;
}
StrongBodyLabel#cardTitle {
    font: 18px 'Microsoft YaHei Light';
    font-weight: 600;
    color: #303133;
}

/* 数据表格 */
QTableWidget {
    background-color: #ffffff;
    border: 1px solid #dcdfe6;
    gridline-color: #ebeef5;
}
QHeaderView::section {
    background-color: #f5f7fa;
    padding: 4px;
    border: none;
    font-weight: 600;
    color: #606266;
}
QTableWidget::item {
    padding: 4px;
    color: #606266;
}

/* 操作按钮（刷新/清空） */
HistoryInterface PushButton {
    background: transparent;
    border: none;
    color: #409EFF;
    font-size: 14px;
}
HistoryInterface PushButton:hover {
    color: #66B1FF;
}

/* 弹窗提示（InfoBar） */
InfoBar {
    border-radius: 4px;
    padding: 8px 12px;
}
