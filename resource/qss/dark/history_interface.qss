/* 历史记录页 dark */
HistoryInterface, #historyView {
    background-color: transparent;
}
ScrollArea {
    border: none;
    background-color: transparent;
}

/* 顶部标题区 */
SubtitleLabel#pageTitle {
    font: 24px 'Microsoft YaHei Light';
    font-weight: 600;
    color: #FFFFFF;
}
BodyLabel#pageDescription {
    font: 14px 'Microsoft YaHei Light';
    color: #C0C4CC;
}

/* 表格卡片 */
CardWidget#tableCard {
    background-color: rgba(24, 24, 24, 0.85);
    border-radius: 8px;
}
StrongBodyLabel#cardTitle {
    font: 18px 'Microsoft YaHei Light';
    font-weight: 600;
    color: #FFFFFF;
}

/* 数据表格 */
QTableWidget {
    background-color: #2b2b2b;
    border: 1px solid #444444;
    gridline-color: #3c3c3c;
}
QHeaderView::section {
    background-color: #1f1f1f;
    padding: 4px;
    border: none;
    font-weight: 600;
    color: #C0C4CC;
}
QTableWidget::item {
    padding: 4px;
    color: #DDDDDD;
}

/* 操作按钮（刷新/清空） */
HistoryInterface PushButton {
    background: transparent;
    border: none;
    color: #409EFF;
    font-size: 14px;
}
HistoryInterface PushButton:hover {
    color: #66B1FF;
}

/* 弹窗提示（InfoBar） */
InfoBar {
    border-radius: 4px;
    padding: 8px 12px;
    color: #FFFFFF;
}
