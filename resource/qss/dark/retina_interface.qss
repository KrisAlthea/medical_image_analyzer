
/* RetinaInterface 视网膜分析页 dark */
RetinaInterface, #view {
    background-color: transparent;
}

ScrollArea {
    border: none;
    background-color: transparent;
}

/* 顶部标题区 */
SubtitleLabel#pageTitle {
    font: 24px 'Microsoft YaHei Light';
    font-weight: 600;
    color: #FFFFFF;
}
BodyLabel#pageDescription {
    font: 14px 'Microsoft YaHei Light';
    color: #C0C4CC;
}

/* 卡片通用样式 */
CardWidget {
    background-color: rgba(24, 24, 24, 0.85);
    border-radius: 8px;
}

/* 卡片标题 */
StrongBodyLabel#cardTitle {
    font: 18px 'Microsoft YaHei Light';
    font-weight: 600;
    color: #FFFFFF;
}

/* 图像展示区 */
ImageLabel#imageLabel {
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 6px;
}

/* 操作面板按钮 */
#controlCard PushButton {
    background: transparent;
    border: none;
    color: #409EFF;
    font-size: 14px;
    text-align: left;
    padding: 6px 0;
}

/* 结果文本区 */
TextEdit#resultText {
    background-color: rgba(255, 255, 255, 0.03);
    border-radius: 6px;
    color: #DDDDDD;
}

/* 导出报告按钮 */
PushButton#exportButton {
    background-color: #409EFF;
    color: #FFFFFF;
    border-radius: 4px;
    padding: 4px 12px;
    min-height: 28px;
}
PushButton#exportButton:hover {
    background-color: #66B1FF;
}

/* 弹窗提示（InfoBar）*/
InfoBar {
    border-radius: 4px;
    padding: 8px 12px;
    color: #FFFFFF;
}
